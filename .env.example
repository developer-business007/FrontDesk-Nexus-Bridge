# DualPMS VPS bridge — copy to bridge/.env on the DualPMS server
# Supabase — use service_role (NOT anon / VITE_SUPABASE_ANON_KEY)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_jwt

# Decrypts SynXis + eZee credentials from app_settings (same key as Supabase edge secrets)
EZEE_SECRETS_KEY=base64_32byte_key

# Local Postgres (DualPMS `hotel` DB on same VPS)
PGDATABASE=hotel

# Full sync cycle interval (milliseconds) — default 10s
BRIDGE_INTERVAL_MS=10000

# Fast poll when DualPMS sync_time changes (milliseconds) — default 2s
BRIDGE_FAST_POLL_MS=2000
